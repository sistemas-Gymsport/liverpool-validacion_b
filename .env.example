# Copia de referencia. NO pongas valores reales aquí.
# Genera backend/.env con: python crear_usuario.py
APP_USUARIO='usuario_de_ejemplo'
APP_PASSWORD_HASH='pbkdf2:sha256:...(lo genera crear_usuario.py)...'
SECRET_KEY='genera-una-clave-aleatoria-de-al-menos-32-caracteres'

# Local: 0 (http). Producción con HTTPS: 1.
COOKIE_SECURE='0'
FLASK_ENV='development'
PORT='8000'

# Opcionales
# COOKIE_SAMESITE='Lax'           # 'None' solo en modo de subida directa a Render (requiere COOKIE_SECURE=1)
# CORS_ORIGINS=''                 # Orígenes exactos separados por coma, solo en modo directo
# TRUSTED_PROXIES='0'             # Proxies delante de la app (Render: 1)
# MAX_TOTAL_MB='220'              # Tamaño máximo total por verificación
